{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "jarvisai": {
      "root": "jarvisai",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "jarvisai/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "jarvisai" }
    },
    {
      "source": "/docs",
      "destination": { "service": "jarvisai" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "jarvisai" }
    },
    {
      "source": "/manus-routes.json",
      "destination": { "service": "jarvisai" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
