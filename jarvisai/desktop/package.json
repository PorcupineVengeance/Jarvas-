{
  "name": "jarvis-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "JARVIS Desktop — local personal AI assistant with permissioned computer control",
  "main": "main.js",
  "author": "JARVIS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.jarvisai.desktop",
    "productName": "JARVIS",
    "copyright": "Copyright © JARVIS",
    "icon": "resources/icon.png",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar",
        "to": "sidecar",
        "filter": ["**/*"]
      },
      {
        "from": "resources/frontend",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "JARVIS-mac.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS needs the microphone so you can talk to your assistant.",
        "NSSpeechRecognitionUsageDescription": "JARVIS can use speech recognition for wake-word and voice commands."
      }
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "JARVIS-win.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
