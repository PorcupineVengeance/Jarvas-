# Project-provided Manus services (optional; used in managed Cloud runtimes).
MANUS_API_URL=
MANUS_API_KEY=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# OpenAI-compatible LLM (Groq, OpenAI, etc.). Prefer a URL ending in /v1.
JARVIS_LLM_API_URL=https://api.groq.com/openai/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=qwen/qwen3.8-27b

# Speech-to-text (OpenAI-compatible Whisper endpoint; Groq supported).
JARVIS_STT_API_URL=https://api.groq.com/openai/v1
JARVIS_STT_API_KEY=
JARVIS_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech: provider = openai | fish
JARVIS_TTS_PROVIDER=fish
JARVIS_TTS_API_URL=https://api.fish.audio
JARVIS_TTS_API_KEY=
JARVIS_TTS_MODEL=s2.1-pro-free
JARVIS_TTS_VOICE=41f0953d7a6b4c078445c7e65d620eeb

# Open access: skip the sign-in screen (recommended for personal deploys).
JARVIS_OPEN_ACCESS=true

# Local standalone auth when Manus OAuth is not configured (optional if open access is on).
JARVIS_LOCAL_AUTH_ENABLED=true
JARVIS_LOCAL_AUTH_SECRET=change-me-to-a-long-random-string
JARVIS_LOCAL_AUTH_DISPLAY_NAME=Operator

# Research: duckduckgo (no key) | tavily | manus
JARVIS_RESEARCH_PROVIDER=duckduckgo
JARVIS_TAVILY_API_KEY=
JARVIS_RESEARCH_API_ID=

# Storage — local SQLite is fine on your machine.
# On Vercel + Supabase, the integration already sets POSTGRES_URL /
# POSTGRES_URL_NON_POOLING — JARVIS picks those up automatically.
# You can also set DATABASE_URL explicitly:
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./data/jarvis.db
JARVIS_STORAGE_DIR=./storage

JARVIS_ENABLE_COMPUTER_CONTROL=false
JARVIS_ALLOWED_PATHS=~/Desktop,~/Documents,~/Downloads
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_CONTINUOUS_LISTENING=false
JARVIS_MAX_UPLOAD_MB=15
JARVIS_SESSION_TTL_SECONDS=28800
JARVIS_ALLOWED_ORIGINS=
