# Project-provided Manus services (optional; used in managed Cloud runtimes).
MANUS_API_URL=
MANUS_API_KEY=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# OpenAI-compatible LLM (Groq, OpenAI, etc.). Prefer a URL ending in /v1.
JARVIS_LLM_API_URL=https://api.groq.com/openai/v1
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=qwen/qwen3.8-27b

# Speech-to-text (OpenAI-compatible Whisper endpoint; Groq supported).
JARVIS_STT_API_URL=https://api.groq.com/openai/v1
JARVIS_STT_API_KEY=
JARVIS_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech: provider = openai | fish
JARVIS_TTS_PROVIDER=fish
JARVIS_TTS_API_URL=https://api.fish.audio
JARVIS_TTS_API_KEY=
JARVIS_TTS_MODEL=s2.1-pro-free
JARVIS_TTS_VOICE=41f0953d7a6b4c078445c7e65d620eeb

# Open access: skip the sign-in screen on desktop / personal deploys.
# When Supabase Auth is configured on the public web, signup/login is required even if this is true.
JARVIS_OPEN_ACCESS=true

# Local standalone auth when Manus OAuth / Supabase is not configured (optional if open access is on).
JARVIS_LOCAL_AUTH_ENABLED=true
JARVIS_LOCAL_AUTH_SECRET=change-me-to-a-long-random-string
JARVIS_LOCAL_AUTH_DISPLAY_NAME=Operator

# Supabase Auth — email/password signup + login (Project Settings → API).
# Use the same project as your Postgres if you already connected Supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Optional: auto-confirm new accounts (server-side). Keep secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Research: duckduckgo (no key) | tavily | manus
JARVIS_RESEARCH_PROVIDER=duckduckgo
JARVIS_TAVILY_API_KEY=
JARVIS_RESEARCH_API_ID=
# Live web search, page fetch, and Open-Meteo weather (user can also toggle in Desktop Settings).
JARVIS_ENABLE_LIVE_WEB=true

# Storage — local SQLite is fine on your machine.
# On Vercel + Supabase, the integration already sets POSTGRES_URL /
# POSTGRES_URL_NON_POOLING — JARVIS picks those up automatically.
# You can also set DATABASE_URL explicitly:
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./data/jarvis.db
JARVIS_STORAGE_DIR=./storage

JARVIS_ENABLE_COMPUTER_CONTROL=false
# Bluetooth list/connect/disconnect for paired accessories (Desktop only; off by default).
JARVIS_ENABLE_BLUETOOTH=false
# Desktop only: home-wide files + storage/settings tools (still requires computer control).
JARVIS_ENABLE_FULL_DEVICE_ACCESS=false
JARVIS_ALLOWED_PATHS=~/Desktop,~/Documents,~/Downloads
# Set automatically by Electron. Do not enable on hosted/cloud deploys.
JARVIS_DESKTOP=false
# Public base URL for installers (must host JARVIS-mac.dmg and JARVIS-win.exe).
# Example: https://github.com/PorcupineVengeance/Jarvas-/releases/latest/download
# Enables Download buttons on the web sign-in screen, Settings, and About.
JARVIS_DESKTOP_DOWNLOAD_BASE=https://github.com/PorcupineVengeance/Jarvas-/releases/latest/download
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_CONTINUOUS_LISTENING=false
JARVIS_MAX_UPLOAD_MB=15
JARVIS_SESSION_TTL_SECONDS=28800
JARVIS_ALLOWED_ORIGINS=
