# Project-provided Manus services are injected at runtime in managed Cloud.
# Do not paste keys into source, commit .env, or send them to the frontend.
MANUS_API_URL=
MANUS_API_KEY=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Optional OpenAI-compatible LLM provider; normally use a URL ending in /v1.
# Leave all three unset to use the managed Manus AI adapter by default.
JARVIS_LLM_API_URL=
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=

# Optional provider adapters. Leave unset until securely configured.
JARVIS_RESEARCH_API_ID=
JARVIS_TTS_API_URL=
JARVIS_TTS_API_KEY=
JARVIS_TTS_MODEL=
JARVIS_TTS_VOICE=alloy
JARVIS_ALLOWED_ORIGINS=

# Local default. Cloud uses DATABASE_URL when supplied by the managed database.
DATABASE_URL=sqlite:///./data/jarvis.db
JARVIS_SESSION_TTL_SECONDS=28800
JARVIS_MAX_UPLOAD_MB=15
