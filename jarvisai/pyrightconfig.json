{
  "include": ["backend"],
  "exclude": ["**/__pycache__", "**/.pytest_cache", ".venv"],
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["backend", ".venv/lib/python3.12/site-packages"],
  "executionEnvironments": [
    { "root": "backend" }
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true
}
